---
import MainLayout, { siteTitle } from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { companyInfo, faqs } from '../data/siteConfig.js';

const pageTitle = `常见问题 - ${siteTitle}`;
const pageDescription = `${companyInfo.name}小程序与后台管理系统交付的常见问题，含系统适配、标准与定制开发、演示、上线与售后等说明。`;
---
<MainLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-emerald-50 via-white to-amber-50 pt-28 pb-16 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 md:pt-36 md:pb-20">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-black tracking-widest text-emerald-700">FAQ</p>
        <h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white md:text-6xl">常见问题</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">关于系统适配、标准交付与二次开发、演示和上线的常见疑问，这里先做说明。</p>
      </div>
    </section>

    <section class="bg-white py-16 dark:bg-slate-950 md:py-24">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group rounded-[2rem] border border-slate-100 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900 open:border-emerald-700/30 open:bg-[#f8fbff] dark:open:bg-slate-800">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-black text-slate-950 dark:text-white">
                {faq.question}
                <span class="mt-1 shrink-0 text-emerald-700 transition group-open:rotate-45 dark:text-emerald-300">+</span>
              </summary>
              <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="mt-10 text-center text-sm leading-7 text-slate-500 dark:text-slate-400">
          还有其他问题，直接拨打电话
          <a href={`tel:${companyInfo.phone}`} class="ml-1 font-black text-emerald-700 dark:text-emerald-300">{companyInfo.phone}</a>
          或发送邮件至
          <a href={`mailto:${companyInfo.email}`} class="ml-1 font-black text-emerald-700 dark:text-emerald-300">{companyInfo.email}</a>。
        </p>
      </div>
    </section>

    <section class="bg-slate-50 py-16 dark:bg-slate-900 md:py-20">
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:px-6 lg:px-8">
        <h2 class="text-2xl font-black text-slate-950 dark:text-white md:text-3xl">没找到答案，直接聊业务。</h2>
        <p class="max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300">说明你的业务类型和想解决的问题，我们会先判断系统适配度，再沟通演示、配置范围与交付方式。</p>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="rounded-full bg-emerald-700 px-8 py-4 text-center font-black text-white transition hover:bg-emerald-800">联系我们</a>
          <a href="/solutions" class="rounded-full border border-emerald-700/30 bg-white px-8 py-4 text-center font-black text-emerald-700 transition hover:bg-emerald-50 dark:border-emerald-300/30 dark:bg-slate-800 dark:text-emerald-300">查看解决方案</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
