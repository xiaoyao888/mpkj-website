---
import MainLayout, { siteTitle } from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { companyInfo, features } from '../data/siteConfig.js';

const pageTitle = `联系我们 - ${siteTitle}`;
const pageDescription = `联系${companyInfo.name}咨询小程序与后台管理系统交付，电话 ${companyInfo.phone}，含咨询前准备事项与沟通流程说明。`;
---
<MainLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="relative overflow-hidden bg-[#f6f3ea] pt-28 pb-16 dark:bg-slate-950 md:pt-36 md:pb-20">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-black tracking-widest text-emerald-700">CONTACT</p>
        <h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white md:text-6xl">联系我们</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">说明你的业务类型和想解决的问题，我们会先判断系统适配度，再沟通演示、配置范围、定制开发和交付方式。</p>
      </div>
    </section>

    <section class="bg-white py-16 dark:bg-slate-950 md:py-24">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[.9fr_1.1fr] lg:px-8">
        <div class="rounded-[2rem] bg-slate-950 p-8 text-white shadow-xl shadow-slate-900/15 dark:bg-slate-900">
          <h2 class="text-3xl font-black">直接联系</h2>
          <div class="mt-8 space-y-4 text-sm">
            <a href={`tel:${companyInfo.phone}`} class="block rounded-2xl bg-white px-5 py-4 font-black text-slate-950">电话：{companyInfo.phone}</a>
            <a href={`mailto:${companyInfo.email}`} class="block rounded-2xl bg-white/10 px-5 py-4 font-black text-white">邮箱：{companyInfo.email}</a>
            <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4">
              <div class="text-xs font-black uppercase tracking-wider text-slate-400">公司地址</div>
              <div class="mt-2 font-bold leading-6 text-white">{companyInfo.address}</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4">
              <div class="text-xs font-black uppercase tracking-wider text-slate-400">公司主体</div>
              <div class="mt-2 font-bold leading-6 text-white">{companyInfo.fullName}</div>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-slate-100 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="text-2xl font-black text-slate-950 dark:text-white">咨询前建议准备</h2>
          <ol class="mt-6 list-decimal space-y-4 pl-5 text-sm leading-7 text-slate-600 dark:text-slate-300">
            <li>业务类型：商城、订水配送、预约、托管辅导、本地生活或其他场景。</li>
            <li>端口需求：是否需要微信小程序、H5、PC 后台、商户后台或员工端。</li>
            <li>核心流程：客户下单、支付、核销、配送、售后、财务或分账规则。</li>
            <li>账号情况：是否已有小程序账号、微信支付商户号、备案域名和服务器。</li>
            <li>上线节奏：是快速试运行，还是需要完整定制开发。</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-16 dark:bg-slate-900 md:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-center text-3xl font-black text-slate-950 dark:text-white">沟通时我们会提供</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((feature) => (
            <article class="rounded-3xl bg-white p-6 text-center shadow-sm dark:bg-slate-800">
              <div class="text-4xl">{feature.icon}</div>
              <h3 class="mt-4 font-black text-slate-950 dark:text-white">{feature.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
