---
import MainLayout, { siteTitle } from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { companyInfo, solutionProjects } from '../data/siteConfig.js';
import { solutionDetails } from '../data/solutionDetails.js';

const scenesById = Object.fromEntries(solutionDetails.map((item) => [item.id, item.scenes]));

const pageTitle = `解决方案 - ${siteTitle}`;
const pageDescription = `${companyInfo.name}已交付的秒派送水系统、自习室预约系统与托管辅导系统，均包含小程序端与后台管理系统，支持标准交付与二次开发。`;
---
<MainLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <section class="bg-[#f6f3ea] pt-28 pb-14 dark:bg-slate-950 md:pt-36">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-black tracking-widest text-emerald-700">SOLUTIONS</p>
        <h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white md:text-5xl">解决方案</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">三套已在真实业务中运行的系统，均由小程序前台与后台管理组成，可按你的业务流程直接套用或改造。</p>
      </div>
    </section>

    <section class="bg-white py-16 dark:bg-slate-950 md:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6">
          {solutionProjects.map((item, index) => (
            <a href={`/solutions/${item.id}/`} class="group grid gap-8 rounded-[2rem] border border-slate-950/5 bg-[#f8fbff] p-8 shadow-sm transition hover:-translate-y-1 hover:border-emerald-700/30 hover:shadow-xl dark:border-white/10 dark:bg-slate-900 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="text-xs font-black uppercase tracking-[0.28em] text-emerald-700 dark:text-emerald-300">{item.subtitle}</span>
                  <span class="text-sm font-black text-slate-300 dark:text-slate-600">0{index + 1}</span>
                </div>
                <h2 class="mt-5 text-3xl font-black tracking-[-0.03em] text-slate-950 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-300">{item.title}</h2>
                <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">{item.description}</p>
                <span class="mt-6 inline-block text-sm font-black text-emerald-700 dark:text-emerald-300">查看详情 <span class="inline-block transition group-hover:translate-x-1">→</span></span>
              </div>
              <div class="rounded-[1.5rem] bg-white p-6 shadow-sm dark:bg-slate-800">
                <h3 class="text-xs font-black uppercase tracking-[0.2em] text-slate-400">适用场景</h3>
                <div class="mt-4 grid gap-5 sm:grid-cols-2">
                  {scenesById[item.id].map((scene) => (
                    <div>
                      <div class="text-sm font-black text-slate-950 dark:text-white">{scene.title}</div>
                      <p class="mt-1 text-xs leading-6 text-slate-600 dark:text-slate-300">{scene.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
